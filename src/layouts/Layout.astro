---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro"
import "../styles/global.css";
export interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="../portfolio/assets/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:title" content="Wojciech Dzwonczyk | UX/UI Designer and Front-end Developer" />
		<meta property="og:url" content="https://wdzwonczyk.github.io/portfolio/" />
		<meta property=”og:image” content="https://wdzwonczyk.github.io/portfolio/assets/avatar.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>
	</head>
	<body>
		<!-- <img class="absolute top-0 left-0 right-0 w-full" src="../assets/bg-main.png"/> -->
		<Nav/>
		<div>
			<slot />
		</div>
		<Footer/>
	</body>
</html>
<style is:global>
	html {
		font-family: "Ubuntu", ui-sans-serif, system-ui, sans-serif;
		background-color: #FFFFFF;
		/*background-image: url("../assets/bg-main.png");*/
		/*background-position: top;*/
		/*background-repeat: no-repeat;*/
		/*background-size: contain;*/
		scroll-behavior: smooth;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: "Ubuntu", ui-sans-serif, system-ui, sans-serif;
	}

	.h-display{
		font-size: 14dvh;
	}

	.h1{
		font-size: 32px;
	}

	/* H2 class */
	.h2{
		font-size: 1.5rem;
		font-weight: 700;
	}

	.skill-heading {
		font-size: 1.125rem;
		font-family: "Ubuntu", ui-sans-serif, system-ui, sans-serif;
	}

	@media (max-width: 768px){
        html {
			background-image: url("../assets/bg-main-sm.png");
	}
    }
	@media (min-width: 768px){
		.h2{
			font-size: 1.875rem;
		}
	}
</style>
