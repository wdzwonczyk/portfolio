---
import type { CollectionEntry } from "astro:content";

export interface Props {
	project: CollectionEntry<"work">;
}

const { data } = Astro.props.project;
const routeId = Astro.props.project.id;
const baseNorm = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const detailHref = `${baseNorm}work/${routeId}`;

function splitTagName(tagName?: string): string[] {
	if (!tagName?.trim()) return [];
	if (tagName.includes("|")) {
		return tagName
			.split(/\s*\|\s*/)
			.map((t) => t.trim())
			.filter(Boolean);
	}
	return tagName
		.split(",")
		.map((t) => t.trim())
		.filter(Boolean);
}

const tags = splitTagName(data.tagName).map((t) => t.replace(/\s+/g, " ").trim()).filter(Boolean);

const previewTitle =
	(typeof data.titleLong === "string" && data.titleLong.trim()) || data.title;

const rawDesc =
	(typeof data.metaDescription === "string" && data.metaDescription.trim()) ||
	(typeof data.productType === "string" && data.productType.trim()) ||
	"";
const description = rawDesc.replace(/\s+/g, " ").trim().slice(0, 240);
const descriptionEllipsis =
	description.length >= 240 && rawDesc.replace(/\s+/g, " ").trim().length > 240;
---

<a
	href={detailHref}
	class="group flex w-full min-w-0 flex-col gap-6 overflow-hidden py-6 text-left md:flex-row md:items-stretch md:gap-10 md:py-8"
>
	<div class="flex min-h-0 min-w-0 flex-[1] flex-col justify-between gap-8">
		<div class="min-w-0">
			<!-- Slightly smaller than section .h2 (1.5rem / 1.875rem) -->
			<h3 class="font-heading text-xl font-bold leading-snug tracking-tight text-neutral-900 md:text-[1.625rem]">
				{previewTitle}
			</h3>
			<p class="mt-2 text-sm leading-relaxed text-neutral-600 md:text-base">
				{description}
				{descriptionEllipsis ? "…" : ""}
			</p>
			{
				tags.length > 0 && (
					<ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
						{tags.map((tag) => (
							<li>
								<span class="inline-block rounded-full bg-neutral-900 px-3 py-1.5 text-xs font-medium text-white md:text-sm">
									{tag}
								</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
		<span
			class="inline-flex w-fit shrink-0 items-center gap-2 px-4 py-2.5 text-sm font-medium text-neutral-900 md:text-base"
		>
			View project details
			<i
				class="iconoir-arrow-right text-base leading-none transition-transform duration-200 ease-out group-hover:translate-x-1 md:text-lg"
				aria-hidden="true"
			/>
		</span>
	</div>

	<div
		class="relative aspect-4/3 w-full min-w-0 shrink-0 overflow-hidden rounded-xl bg-neutral-200 md:aspect-auto md:min-h-80 md:flex-[1.45] md:self-stretch lg:min-h-[500px]"
	>
		<img
			src={data.img}
			alt={data.img_alt}
			class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03] md:absolute md:inset-0 md:min-h-full"
			loading="lazy"
			decoding="async"
		/>
		<!-- Inner device accent (wireframe detail) -->
		<!-- <div
			class="pointer-events-none absolute bottom-3 left-1/2 hidden h-[42%] w-[22%] max-w-26 -translate-x-1/2 rounded-t-lg bg-neutral-400/35 ring-1 ring-neutral-500/20 md:block"
			aria-hidden="true"
		/> -->
	</div>
</a>
