---
const textLinks: { label: string; href: string }[] = [
	{ label: "Home", href: "/portfolio/" },
	{ label: "Work", href: "/portfolio/work/" },
	{ label: "About", href: "/portfolio/about/" },
];

const linkedinUrl = "https://www.linkedin.com/in/wojciech-dzwonczyk";

function linkActive(href: string): boolean {
	return (
		Astro.url.pathname === href ||
		(href !== "/portfolio/" && Astro.url.pathname.startsWith(href))
	);
}

const linkClass =
	"px-4 py-3 rounded-full ease-in-out duration-300 text-center md:w-auto md:min-w-0";

const availableCtaClass =
	"relative isolate inline-flex min-h-[2.5rem] items-center justify-center overflow-hidden rounded-full px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-[transform,box-shadow] hover:opacity-[0.98] hover:shadow-md active:scale-[0.99] sm:text-sm";
---

<nav
	class="fixed inset-x-0 top-0 z-[9999] flex w-full items-center justify-between px-4 py-2 duration-300 md:px-8 lg:px-16"
>
	<div
		id="nav-backdrop"
		class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-500 ease-out [background:linear-gradient(to_bottom,transparent,rgb(255_255_255/0.88))] backdrop-blur-xl backdrop-saturate-150"
		aria-hidden="true"
	/>
	<div class="shrink-0 py-2">
		<a href="/portfolio/" class="flex items-center gap-x-2 text-neutral-900">
			<img
				src="/portfolio/assets/logo/logo.svg"
				alt="Logo Wojciech Dzwonczyk"
				class="h-6"
			/>
		</a>
	</div>

	<!-- Desktop: centered pill tabs -->
	<div class="hidden min-w-0 flex-1 justify-center md:flex">
		<ul
			class="flex flex-row items-center gap-1 rounded-full bg-white px-2 py-4 shadow-md ring-1 ring-neutral-200/80 md:gap-x-1"
		>
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={linkActive(href) ? "page" : undefined}
							class:list={[
								linkClass,
								{
									"rounded-full bg-indigo-600 text-white": linkActive(href),
									"rounded-full text-neutral-900 hover:bg-indigo-100": !linkActive(href),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<a
		href={linkedinUrl}
		target="_blank"
		rel="noopener noreferrer"
		class:list={[availableCtaClass, "nav-available-cta hidden shrink-0 bg-teal-500 md:inline-flex"]}
	>
		<span
			class="nav-available-cta__shine pointer-events-none absolute inset-0 bg-linear-to-r from-teal-400 via-sky-500 to-indigo-600"
			aria-hidden="true"
		/>
		<span class="relative z-10">Available to work</span>
	</a>

	<!-- Mobile overlay menu -->
	<div id="menu-content" class="md:hidden">
		<ul
			id="nav-items"
			class="fixed bottom-0 right-0 z-[9998] flex h-[calc(100vh-56px)] w-full -translate-x-full transform flex-col items-center justify-center gap-6 bg-white/90 backdrop-blur-lg transition-all duration-300 ease-in-out"
		>
			{
				textLinks.map(({ label, href }) => (
					<li class="w-4/5 max-w-xs">
						<a
							aria-current={linkActive(href) ? "page" : undefined}
							class:list={[
								linkClass,
								"block w-full",
								{
									"bg-indigo-600 text-white": linkActive(href),
									"text-neutral-900 hover:bg-indigo-100": !linkActive(href),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
			<li class="w-4/5 max-w-xs pt-2">
				<a
					href={linkedinUrl}
					target="_blank"
					rel="noopener noreferrer"
					class:list={[availableCtaClass, "nav-available-cta block w-full bg-teal-500 px-4 py-3 text-center text-sm"]}
				>
					<span
						class="nav-available-cta__shine pointer-events-none absolute inset-0 bg-linear-to-r from-teal-400 via-sky-500 to-indigo-600"
						aria-hidden="true"
					/>
					<span class="relative z-10">[available to work]</span>
				</a>
			</li>
		</ul>
	</div>
</nav>
<div
	id="hamburger-button"
	class="fixed right-0 top-1/2 z-[9999999] flex h-12 w-16 -translate-y-1/2 items-center justify-start rounded-s-full bg-indigo-600 md:hidden"
>
	<div class="ml-1 flex h-10 w-10 items-center justify-center rounded-full bg-white">
		<img
			src="/portfolio/assets/icons/menu.svg"
			id="nav-icon"
			alt="Navigation icon"
			class="scale-100 duration-200"
		/>
	</div>
</div>
<script>
	//MOBILE NAVIGATION
	const burgerBtn = document.getElementById("hamburger-button") as HTMLElement;
	const navIcon = document.getElementById("nav-icon") as HTMLElement;
	const mobileNav = document.getElementById("nav-items") as HTMLElement;
	const body = document.body;

	function navIconProperties(src: string, alt: string) {
		navIcon.setAttribute("src", src);
		navIcon.setAttribute("alt", alt);
	}

	function navIconToggle() {
		if (navIcon.getAttribute("src") == "/portfolio/assets/icons/menu.svg") {
			navIcon.classList.replace("scale-100", "scale-0");
			setTimeout(() => {
				navIconProperties("/portfolio/assets/icons/cancel.svg", "Close navigation icon");
				navIcon.classList.replace("scale-0", "scale-100");
			}, 200);
		} else {
			navIcon.classList.replace("scale-100", "scale-0");
			setTimeout(() => {
				navIconProperties("/portfolio/assets/icons/menu.svg", "Navigation icon");
				navIcon.classList.replace("scale-0", "scale-100");
			}, 200);
		}
	}

	function openCloseNav() {
		mobileNav.classList.toggle("-translate-x-full");
		body.classList.toggle("overflow-hidden");
		navIconToggle();
	}

	burgerBtn.addEventListener("click", () => openCloseNav());

	//STICKY NAV — gradient transparent → white + blur
	const nav = document.querySelector("nav") as HTMLElement;
	const navBackdrop = document.getElementById("nav-backdrop") as HTMLElement | null;

	window.addEventListener("scroll", () => {
		const scrolled = window.scrollY > 50;
		if (scrolled) {
			nav.classList.add("shadow-sm", "ring-1", "ring-black/5");
			navBackdrop?.classList.remove("opacity-0");
			navBackdrop?.classList.add("opacity-100");
		} else {
			nav.classList.remove("shadow-sm", "ring-1", "ring-black/5");
			navBackdrop?.classList.add("opacity-0");
			navBackdrop?.classList.remove("opacity-100");
		}
	});
</script>
<style is:global>
	@keyframes nav-available-cta {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}
	.nav-available-cta__shine {
		animation: nav-available-cta 4.5s ease-in-out infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-available-cta__shine {
			animation: none;
			opacity: 0.35;
		}
	}
</style>
