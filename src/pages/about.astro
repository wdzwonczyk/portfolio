---
import Layout from '../layouts/Layout.astro';
import ExperienceLayout from '../sections/ExperienceLayout.astro';
import CVLayout from '../sections/CVLayout.astro';
import Badge from '../components/Badge.astro';
import { AnimatedGradientText } from '@/components/ui/animated-gradient-text';
const designSkills = [
	"Figma",
	"Design systems",
	"Style guides",
	"Mockups",
	"Wireframes",
	"Prototypes",
	"Accessibility",
	"UX Research",
	"Design Thinking",
	"User-centric approach",
]

const codingSkills = [
	"HTML",
	"CSS",
	"Tailwind",
	"JavaScript",
	"React",
	"Ionic React",
	"Astro framework",
]
---

<Layout title="About Me | Product Designer" description="As a Product Designer, I bring a mix of creativity, product thinking, and practical design execution to every project. I care deeply about the small details, design consistency, and working closely with developers to make sure every product feels polished from concept to launch. From wireframes to final interfaces, I focus on creating experiences that solve real problems and make a meaningful impact.">
	<main>
		<section class="w-full px-6 pb-12 md:pb-16 lg:pb-24">
			<div class="mx-auto max-w-[1080px] w-full">
				<div id="imageContainer" class="h-[75vh] flex justify-center items-center gap-x-8">
					<h1 class="mb-4 sm:mb-0 sm:mt-4 md:text-center">
						<p class="text-6xl md:text-8xl font-bold">
							I'm Wojciech<br>
							<AnimatedGradientText
								speed={0.9}
								className="font-semibold tracking-tight"
							>
								Product Designer
							</AnimatedGradientText>
						</p>
					</h1>
				</div>
				<div class="w-full">
					<h2 class="text-2xl md:text-3xl font-bold mb-8">Who I am</h2>
					<div class="flex flex-col md:flex-row gap-x-16">
						<div class="w-full text-justify md:w-3/4">
							<p>I design products that sit at the intersection of user needs and business goals - and I'm close enough to the code to know what's actually buildable.</p><br>
							<p>Over the past 4+ years, I've worked on everything from consumer apps to internal tools. The context changes. My approach doesn't: understand the problem first, design second.
							</p><br>
							<p>Being a designer who can also build means I don't hand things off and hope for the best. I stay involved through implementation, catch edge cases early, and make sure what ships actually matches what was designed.
							</p><br>
							<p>I work best in cross-functional teams - with developers, PMs, and stakeholders in the same room (or Slack channel). I ask questions that sometimes make people uncomfortable, take feedback without ego, and keep iterating until the thing is right.</p><br>
							<p>I take the work seriously. At the same time, I'm the person who'll drop the right meme in Slack at exactly the right moment - and somehow that always breaks the tension in a design review. Good teams need that energy too.</p><br>
						</div>
						<div class="w-full my-8 md:my-0 md:w-1/4">
							<h3 class="text-lg font-bold mb-2">Design</h3>
							<div class="gap-x-2 gap-y-2 flex flex-row flex-wrap">
								{designSkills.map((skill) =>(
									<Badge title={skill}/>
								))}
							</div>
							<h3 class="text-lg font-bold mt-4 mb-2">Front-end</h3>
							<div class="gap-x-2 gap-y-2 flex flex-row flex-wrap">
								{codingSkills.map((skill) =>(
									<Badge title={skill}/>
								))}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		
		<ExperienceLayout/>
		<CVLayout
			title="If this sounds like what your team is missing - I'm available."
			href="../assets/cv/Wojciech-Dzwonczyk-cv.pdf"
		/>
	</main>
</Layout>
