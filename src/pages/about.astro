---
import Layout from '../layouts/Layout.astro';
import ExperienceLayout from '../sections/ExperienceLayout.astro';
import CVLayout from '../sections/CVLayout.astro';
import Badge from '../components/Badge.astro';
import { AnimatedGradientText } from '@/components/ui/animated-gradient-text';
const designSkills = [
	"Figma",
	"Design systems",
	"Style guides",
	"Mockups",
	"Wireframes",
	"Prototypes",
	"Accessibility",
	"UX Research",
	"Design Thinking",
	"User-centric approach",
]

const codingSkills = [
	"HTML",
	"CSS",
	"Tailwind",
	"JavaScript",
	"React",
	"Ionic React",
	"Astro framework",
]
---

<Layout title="About Me | Product Designer" description="As a Product Designer, I bring a mix of creativity, product thinking, and practical design execution to every project. I care deeply about the small details, design consistency, and working closely with developers to make sure every product feels polished from concept to launch. From wireframes to final interfaces, I focus on creating experiences that solve real problems and make a meaningful impact.">
	<main>
		<section class="w-full px-6 pb-12 md:pb-16 lg:pb-24">
			<div class="mx-auto max-w-[1080px] w-full">
				<div id="imageContainer" class="h-[75vh] flex justify-center items-center gap-x-8">
					<h1 class="mb-4 sm:mb-0 sm:mt-4 md:text-center">
						<p class="text-6xl md:text-8xl font-bold">
							Hi!👋 <br> I'm 
							<AnimatedGradientText
								speed={0.9}
								className="font-semibold tracking-tight"
							>
								Wojciech
							</AnimatedGradientText>
						</p>
					</h1>
				</div>
				<div class="w-full">
					<h2 class="text-2xl md:text-3xl font-bold mb-8">Who I am</h2>
					<div class="flex flex-col md:flex-row gap-x-16">
						<div class="w-full text-justify md:w-3/4">
							<p>As a UX/UI Designer and Front-end Developer, I bring a unique blend of creativity and technical expertise to every project. With a keen eye for detail and a user-centered approach, I strive to create seamless and intuitive experiences that delight users.</p><br>
							<p>In the realm of UX/UI design, I excel at understanding user needs and crafting visually compelling interfaces. From wireframing to prototyping, I meticulously shape every element to ensure optimal usability and aesthetic appeal. I believe that design is not just about how it looks, but how it feels and functions for the end user.
							</p><br>
							<p>Additionally, my proficiency in front-end development allows me to bring those designs to life with clean and efficient code. I take pride in translating design concepts into interactive websites that are responsive, performant, and accessible across devices.
							</p><br>
							<p>Collaboration is at the heart of my work. I actively engage with cross-functional teams and clients to gather insights and ensure that the final product meets their goals and objectives. I embrace feedback and iterate on designs to achieve the best possible outcomes.</p><br>
							<p>Apart from my professional skills, I bring a great sense of humor and a love for memes to the table. I believe that injecting personality and a touch of fun into design can create memorable experiences that resonate with users.</p><br>
							<p>If you're looking for a passionate UX/UI Designer and Front-end Developer who can transform your ideas into visually appealing and user-friendly digital solutions, let's connect. Together, we can create remarkable experiences that leave a lasting impact.</p>
						</div>
						<div class="w-full my-8 md:my-0 md:w-1/4">
							<h3 class="text-lg font-bold mb-2">Design</h3>
							<div class="gap-x-2 gap-y-2 flex flex-row flex-wrap">
								{designSkills.map((skill) =>(
									<Badge title={skill}/>
								))}
							</div>
							<h3 class="text-lg font-bold mt-4 mb-2">Front-end</h3>
							<div class="gap-x-2 gap-y-2 flex flex-row flex-wrap">
								{codingSkills.map((skill) =>(
									<Badge title={skill}/>
								))}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		
		<ExperienceLayout/>
		<CVLayout
			title="Interested in working together?"
			href="../assets/cv/Wojciech-Dzwonczyk-cv.pdf"
		/>
	</main>
</Layout>
