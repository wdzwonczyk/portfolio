---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CVLayout from '../sections/CVLayout.astro';
import ProjectsLayout from '../sections/ProjectsLayout.astro';
import AboutMeHome from '../sections/AboutMeHome.astro';
import Partnerships from '../sections/Partnerships.astro';
import WorkParallaxPreview from '../sections/WorkParallaxPreview.astro';
---

<Layout title="Wojciech Dzwonczyk | Product Designer" description="Transform ideas into polished digital products with a product designer who bridges the gap between design and development. Explore my work and let’s create thoughtful, user-focused experiences that drive real impact.">
	<Hero title="I Design Products People Use" subTitle="Product Designer who goes from first sketch to shipped product. I care about the decisions that shape a product, not just the screens that represent it."/>
	<main>
		<AboutMeHome/>
		<Partnerships/>
		<ProjectsLayout>
			<h2 class="h2">Selected work</h2>
			<p class="text-lg text-gray-400">Real challenges, thoughtful solutions, and products shaped from idea to execution.</p>
		</ProjectsLayout>
		<!-- <ExperienceLayout/> -->
		<CVLayout
			title="Think we'd work well together?"
			href="/portfolio/assets/cv/Wojciech-Dzwonczyk-cv.pdf"
		/>
	</main>
</Layout>
