---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CVLayout from '../sections/CVLayout.astro';
import ProjectsLayout from '../sections/ProjectsLayout.astro';
import AboutMeHome from '../sections/AboutMeHome.astro';
import Partnerships from '../sections/Partnerships.astro';
import WorkParallaxPreview from '../sections/WorkParallaxPreview.astro';
---

<Layout title="Wojciech Dzwonczyk | UX/UI Designer and Front-end Developer" description="Discover the world of UX/UI Design and Front-end Development through my portfolio. I specialize in creating captivating digital experiences that blend creativity and technical expertise. Explore my work and let's collaborate to bring your ideas to life.">
	<Hero title="Making Great Design Feel Effortless" subTitle="Product Designer with 4+ years of experience creating intuitive interfaces that balance user needs and business goals."/>
	<main>
		<AboutMeHome/>
		<Partnerships/>
		<ProjectsLayout>
			<h2 class="h2">Selected work</h2>
			<p class="text-lg text-gray-400">Real challenges, thoughtful solutions, and products shaped from idea to execution.</p>
		</ProjectsLayout>
		<!-- <ExperienceLayout/> -->
		<CVLayout
			title="Let's shape the future Together!"
			href="/portfolio/assets/cv/Wojciech-Dzwonczyk-cv.pdf"
		/>
	</main>
</Layout>
