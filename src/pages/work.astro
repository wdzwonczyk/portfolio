<Layout title="Portfolio | Wojciech Dzwonczyk" description="Explore a collection of product design projects focused on improving user experience, strengthening visual consistency, and creating seamless collaboration between design and development. Each project highlights thoughtful solutions designed to solve real user and business challenges.">
	<main class="pt-[var(--nav-h)]">
		<ProjectsLayout underFixedNav>
			<h1 class="text-3xl md:text-4xl font-bold">Portfolio</h1>
			<p class="text-lg text-gray-400">Explore my creative work and see my projects in action.</p>
		</ProjectsLayout>
		<CVLayout
			title="Interested in working together?"
